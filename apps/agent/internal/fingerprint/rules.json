{
  "$comment": "日志指纹规则（设计文档 4.1）。TS（packages/shared/src/fingerprint.ts）与 Go（apps/agent/internal/fingerprint）共用。只能使用 RE2 与 JS 都支持的语法：不用 \\s（两边对 Unicode 空白的定义不同）、不用前后断言、不用 i 标志。replace 中用 $1 引用分组。",
  "version": 1,
  "maxFrames": 5,
  "strip": [
    "^\\[?[0-9]{4}[-/][0-9]{2}[-/][0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}([.,][0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?\\]?[ \\t]*",
    "^[A-Z][a-z]{2} +[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2} [^ ]+ ",
    "^\\[?[0-9]{2}:[0-9]{2}:[0-9]{2}([.,][0-9]+)?\\]?[ \\t]*",
    "\\[(main|[^\\]]*([Tt]hread|[Ww]orker|-exec-|[Pp]ool-|nio-)[^\\]]*)\\]",
    "\\b([Rr]equest|[Rr]eq|[Tt]race|[Ss]pan|[Cc]orrelation)[-_]?[Ii][Dd][=:][ \\t]*[^ \\t,;]+"
  ],
  "placeholders": [
    {
      "pattern": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b",
      "replace": "<UUID>"
    },
    {
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replace": "<EMAIL>"
    },
    {
      "pattern": "\\b[0-9]{1,3}(\\.[0-9]{1,3}){3}(:[0-9]+)?\\b",
      "replace": "<IP>"
    },
    {
      "pattern": "\\b0x[0-9a-fA-F]+\\b",
      "replace": "<HEX>"
    },
    {
      "pattern": "\\b[0-9a-fA-F]{12,}\\b",
      "replace": "<HEX>"
    },
    {
      "pattern": "\"[^\"]{0,200}\"",
      "replace": "\"<STR>\""
    },
    {
      "pattern": "'[^' \\t]{0,200}'",
      "replace": "'<STR>'"
    },
    {
      "pattern": "(^|[^A-Za-z0-9_<])-?[0-9]+(\\.[0-9]+)?",
      "replace": "$1<N>"
    },
    {
      "pattern": "[ \\t]+",
      "replace": " "
    }
  ],
  "exceptionTypes": [
    {
      "pattern": "^[ \\t]*(Caused by: )?(([A-Za-z_$][A-Za-z0-9_$]*\\.)+[A-Za-z_$][A-Za-z0-9_$]*(Exception|Error|Throwable))(:|$)",
      "type": "$2"
    },
    {
      "pattern": "^(([A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*(Error|Exception|Exit|Interrupt))(:|$)",
      "type": "$1"
    },
    {
      "pattern": "^(panic): ",
      "type": "$1"
    }
  ],
  "frames": [
    {
      "pattern": "^[ \\t]+at ([A-Za-z0-9_$.<>/]+)\\(",
      "frame": "$1"
    },
    {
      "pattern": "^[ \\t]+at (async )?([^ \\t(]+) \\((.+):[0-9]+:[0-9]+\\)$",
      "frame": "$2@$3"
    },
    {
      "pattern": "^[ \\t]+at (.+):[0-9]+:[0-9]+$",
      "frame": "$1"
    },
    {
      "pattern": "^[ \\t]*File \"([^\"]+)\", line [0-9]+, in ([^ \\t]+)",
      "frame": "$1:$2"
    },
    {
      "pattern": "^(([A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.(\\(\\*?[A-Za-z0-9_]+\\)\\.)?[A-Za-z0-9_.]+)\\(.*\\)$",
      "frame": "$1"
    }
  ],
  "frameworkFrames": "^(java\\.|javax\\.|jdk\\.|sun\\.|com\\.sun\\.|kotlin\\.|kotlinx\\.|scala\\.|org\\.springframework\\.|org\\.apache\\.|org\\.hibernate\\.|org\\.eclipse\\.|io\\.netty\\.|reactor\\.|com\\.fasterxml\\.|com\\.zaxxer\\.|runtime\\.|runtime/|net/http\\.|net\\.|internal/|node:|.*@node:|<anonymous>|.*node_modules/|/usr/lib/python|/usr/local/lib/python|.*site-packages/|.*dist-packages/|<frozen )"
}
